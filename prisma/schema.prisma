// Multi-LLM Agent Orchestration — persistence layer
// Each AgentRoom is a "chat room" for one LLM persona + topic (Round 52 vision).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AgentRoom {
  id             String   @id @default(cuid())
  llm            String   // logical persona label: "qwen" | "glm" | "claude"
  topic          String   // e.g. "widgets-cold-run"
  title          String
  status         String   @default("idle") // idle | running | done | tripped | error
  systemPrompt   String
  taskPrompt     String
  allowedTools   String   @default("[]") // JSON array of permitted skill names (least-privilege)
  schemaContract String   @default("{}") // JSON describing the typed contract the agent must satisfy
  failures       Int      @default(0)
  circuitOpen    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages  AgentMessage[]
  findings  Finding[]
  memories  EpisodicMemory[]
}

model AgentMessage {
  id        String   @id @default(cuid())
  roomId    String
  role      String   // system | user | assistant | tool
  content   String
  tokenEst  Int      @default(0)
  createdAt DateTime @default(now())

  room AgentRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model Finding {
  id        String   @id @default(cuid())
  roomId    String
  severity  String   // info | warn | critical
  title     String
  detail    String
  validated Boolean  @default(false) // two-phase commit: committed only after schema validation
  createdAt DateTime @default(now())

  room AgentRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model EpisodicMemory {
  id        String   @id @default(cuid())
  roomId    String?  // null = shared across all rooms
  kind      String   // event | finding | decision
  content   String
  createdAt DateTime @default(now())

  room AgentRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}
